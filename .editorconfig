# 编辑器统一配置：https://editorconfig.org
# 本项目 .py 一律 Tab 缩进（Tab = 4 列）。
# 改这里之前先看 docs/04-如何改代码.md 第 5.4 节，四处配置要一起改。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4
tab_width = 4

[*.py]
indent_style = tab
indent_size = 4
tab_width = 4
ij_continuation_indent_size = 8
ij_smart_tabs = true

# JSON / YAML / TOML 只能用空格缩进（Tab 会让部分解析器直接报错）
[*.{json,jsonc,yml,yaml,toml}]
indent_style = space
indent_size = 4

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
