[Unit]
Description=FurryReadingBot Data Sync
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/FurryReadingBot
# 脚本内部等 flock 最多 60 秒；TimeoutStartSec 留出 git 执行时间
TimeoutStartSec=180
ExecStart=/bin/bash /root/FurryReadingBot/script/sync_data.sh
StandardOutput=journal
StandardError=journal
